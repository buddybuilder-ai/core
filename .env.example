# ================================================================
#  BUDDY BUILDER — CONFIG ทั้งหมดอยู่ที่นี่ที่เดียว
# ================================================================

# ----------------------------------------------------------------
# OpenRouter API Key
# ----------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ================================================================
# LLM: RAG Chat  (ฮวงจุ้ย Q&A)
# ================================================================
# เลือก backend: ollama (local, ไม่เสีย API cost) | openrouter
LLM_PROVIDER=ollama

# --- Ollama (ใช้เมื่อ LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_RAG=qwen2.5:7b
# OLLAMA_MODEL_RAG=qwen2.5:14b    ← แม่นยำกว่า ใช้ RAM มากกว่า
# OLLAMA_MODEL_RAG=typhoon2:8b    ← ภาษาไทยดีกว่า

# --- OpenRouter fallback (ใช้เมื่อ LLM_PROVIDER=openrouter) ---
LLM_MODEL_RAG=anthropic/claude-3.5-sonnet
LLM_TEMPERATURE_RAG=0.5

# ================================================================
# LLM: Layout Pipeline  (วิเคราะห์และออกแบบห้อง)
# ใช้ OpenRouter เสมอ — ไม่ขึ้นกับ LLM_PROVIDER ด้านบน
# ================================================================
LLM_MODEL_LAYOUT=openai/gpt-4-turbo
LLM_MODEL_ROUTER=openai/gpt-4o-mini
LLM_TEMPERATURE_LAYOUT=0.1

# ================================================================
# Embedding Model
# ⚠️  ถ้าเปลี่ยน ต้อง rebuild vectorstore: make rag-rebuild
# ตัวเลือก:
#   BAAI/bge-m3                          (2.2GB, ดีที่สุด — แนะนำ)
#   intfloat/multilingual-e5-large       (1.1GB, ดี)
#   intfloat/multilingual-e5-base        (280MB, เร็ว)
# ================================================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_LOCAL=BAAI/bge-m3

# ================================================================
# ChromaDB Path
# ⚠️  ใช้ absolute path เพื่อป้องกัน rebuild ผิดที่
# ================================================================
# ⚠️  แก้ให้ตรงกับ path บนเครื่องของคุณ เช่น:
# CHROMA_DB_PATH=/Users/yourname/Documents/Buddy Builder/core/rag_pipeline/vectorstore/chroma_db
CHROMA_DB_PATH=/absolute/path/to/Buddy Builder/core/rag_pipeline/vectorstore/chroma_db

# ================================================================
# RAG Retrieval
# ================================================================
RAG_TOP_K=5
RAG_SEARCH_TYPE=mmr
# mmr = หลากหลาย (แนะนำ) | similarity = แม่นยำ

RAG_RELEVANCE_THRESHOLD=1.03
# L2 distance threshold — ต่ำ = เข้มงวด (0.35) | สูง = ผ่อนปรน (1.0+)

FUZZY_MATCH_THRESHOLD=2
# รองรับพิมพ์ผิดกี่ตัวอักษร: 1=เข้มงวด | 2=แนะนำ | 3=ผ่อนปรน

# ================================================================
# Chunking (สำหรับ rebuild vectorstore)
# ================================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ================================================================
# Conversation Memory
# ================================================================
MAX_HISTORY=10

# ================================================================
# Database
# ================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/buddybuilder

# ================================================================
# Security
# ================================================================
SECRET_KEY=your-super-secret-key-change-in-production

# ================================================================
# CORS
# ================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
