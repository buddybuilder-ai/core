# ================================================================
#  BUDDY BUILDER — CONFIG ทั้งหมดอยู่ที่นี่ที่เดียว
# ================================================================

# ----------------------------------------------------------------
# OpenRouter API Key
# ----------------------------------------------------------------
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ================================================================
# LLM: RAG Chat  (ฮวงจุ้ย Q&A)
# ⚠️  แก้แค่บรรทัดเดียว — format: provider/model-name
# ================================================================
LLM_MODEL=ollama/qwen2.5:7b
# ตัวเลือก Ollama (local ไม่เสีย API cost):
#   ollama/qwen2.5:7b              ← เร็ว ใช้ RAM น้อย (แนะนำเริ่มต้น)
#   ollama/qwen2.5:14b             ← แม่นยำกว่า ใช้ RAM มากกว่า
#   ollama/typhoon2:8b             ← ภาษาไทยดีกว่า
#
# ตัวเลือก Groq (cloud ฟรี ต้องใส่ GROQ_API_KEY):
#   groq/llama-3.3-70b-versatile   ← ฉลาดที่สุด (6,000 req/day free)
#   groq/llama-3.1-8b-instant      ← เร็วที่สุด token น้อย
#   groq/gemma2-9b-it              ← ทางเลือก Google
#
# ตัวเลือก Claude (ต้องใส่ ANTHROPIC_API_KEY):
#   claude/claude-sonnet-4-20250514
#   claude/claude-haiku-4-5-20251001

# --- API Keys (ใส่เฉพาะ provider ที่ใช้) ---
OLLAMA_BASE_URL=http://localhost:11434
# Ollama endpoint (ใช้เมื่อ LLM_MODEL=ollama/...)

GROQ_API_KEY=
# Groq API Key — ดูได้ที่ https://console.groq.com/keys

ANTHROPIC_API_KEY=
# Anthropic API Key — ดูได้ที่ https://console.anthropic.com

# --- OpenRouter (สำหรับ Layout Pipeline เท่านั้น ไม่ใช่ RAG) ---
LLM_MODEL_RAG=anthropic/claude-3.5-sonnet
LLM_TEMPERATURE_RAG=0.7

# ================================================================
# LLM: Layout Pipeline  (วิเคราะห์และออกแบบห้อง)
# ใช้ OpenRouter เสมอ — ไม่ขึ้นกับ LLM_PROVIDER ด้านบน
# ================================================================
LLM_MODEL_LAYOUT=openai/gpt-4-turbo
LLM_MODEL_ROUTER=openai/gpt-4o-mini
LLM_TEMPERATURE_LAYOUT=0.1

# ================================================================
# Embedding Model
# ⚠️  ถ้าเปลี่ยน ต้อง rebuild vectorstore: make rag-rebuild
# ตัวเลือก:
#   BAAI/bge-m3                          (2.2GB, ดีที่สุด — แนะนำ)
#   intfloat/multilingual-e5-large       (1.1GB, ดี)
#   intfloat/multilingual-e5-base        (280MB, เร็ว)
# ================================================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_LOCAL=BAAI/bge-m3

# ================================================================
# ChromaDB Path
# ================================================================
CHROMA_DB_PATH=./chroma_db

# ================================================================
# RAG Retrieval
# ================================================================
RAG_TOP_K=5
RAG_SEARCH_TYPE=mmr
# mmr = หลากหลาย (แนะนำ) | similarity = แม่นยำ

RAG_RELEVANCE_THRESHOLD=1.05
# L2 distance threshold — ต่ำ = เข้มงวด (0.35) | สูง = ผ่อนปรน (1.0+)

FUZZY_MATCH_THRESHOLD=2
# รองรับพิมพ์ผิดกี่ตัวอักษร: 1=เข้มงวด | 2=แนะนำ | 3=ผ่อนปรน

# ================================================================
# LLM Generation Parameters
# ใช้กับ Ollama เท่านั้น (OpenRouter/Claude ไม่ใช้ค่าเหล่านี้)
# ================================================================
TEMPERATURE=0.3
# อุณหภูมิทั่วไป: 0.0 = ตอบตรง | 1.0 = สร้างสรรค์

CONTEXTUAL_TEMPERATURE=0.2
# Temperature สำหรับ step2b (contextual chunking) — ต่ำ = แม่นยำ

QUESTION_GEN_TEMPERATURE=0.4
# Temperature สำหรับ step2c (สร้างคำถาม hypothetical) — ปานกลาง

MAX_TOKENS=2000
# จำนวน tokens สูงสุดในการตอบ

TOP_P=0.9
# Nucleus sampling: 1.0 = ใช้ทุก token | 0.9 = ตัด tail ออก

REPEAT_PENALTY=1.15
# ลงโทษการพูดซ้ำ: 1.0 = ไม่ลงโทษ | >1.0 = หลีกเลี่ยงซ้ำ

# ================================================================
# Chunking (สำหรับ rebuild vectorstore)
# ⚠️  เปลี่ยนแล้วต้อง rebuild: python main.py --rebuild
# ================================================================
CHUNK_SIZE=1000
# ขนาด chunk (ตัวอักษร): แนะนำ 500–1500
CHUNK_OVERLAP=200
# ส่วนทับซ้อนระหว่าง chunk: แนะนำ 10–20% ของ CHUNK_SIZE

QUESTIONS_PER_CHUNK=3
# จำนวนคำถาม hypothetical ต่อ chunk (step2c)

# ================================================================
# Conversation Memory
# ================================================================
MAX_HISTORY=10
# จำนวนรอบสนทนาที่จำไว้ใน memory (เพิ่ม = จำได้นาน แต่ใช้ token มากขึ้น)

# ================================================================
# Database
# ================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/buddybuilder

# ================================================================
# Security
# ================================================================
SECRET_KEY=your-super-secret-key-change-in-production

# ================================================================
# CORS
# ================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
